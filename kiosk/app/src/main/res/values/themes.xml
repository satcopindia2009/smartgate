<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1059: DayNight base. Old theme was forced dark (Theme.Material + #0F1115 window/status/nav),
         so Light mode painted dark behind insets and status/nav icons. Compose SatcopKioskTheme
         re-applies window colors at runtime from the chosen Light/Dark/System mode. -->
    <style name="Theme.SatcopGateKiosk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kiosk_bg</item>
        <item name="android:statusBarColor">@color/kiosk_bg</item>
        <item name="android:navigationBarColor">@color/kiosk_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">#1E806A</item>
    </style>

    <!-- Launch window only: teal background + logo. MainActivity switches to Theme.SatcopGateKiosk before setContent. -->
    <style name="Theme.SatcopGateKiosk.Starting" parent="Theme.SatcopGateKiosk">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_teal</item>
        <item name="android:navigationBarColor">@color/splash_teal</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
